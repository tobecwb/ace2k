# The quality gate's coverage measure. ace2k_klipper_types.py only declares the shape of Klipper's
# objects for the type checker (Protocol bodies are `...`); nothing in it runs.
[run]
omit =
    */klippy/extras/ace2k_klipper_types.py

[report]
# two decimals: the gate compares the measure with COVERAGE_MIN, which has one
precision = 2
# A script's entry guard (`if __name__ == "__main__":` and its block) only runs as a program; the
# tools are measured in process and each has one test that runs it as a program.
# The relative imports of the `try: from . import …` / `except ImportError:` idiom: the host tests
# import the modules by bare name, so the try branch never runs past its first line there, and the
# except branch never runs on the printer. Only the relative-import statements directly before an
# `except ImportError:` (their continuation lines included) are left out.
# An `if TYPE_CHECKING:` block holds imports for the type checker only; it never runs.  The
# pinned coverage leaves it out by default; the line here keeps that if the default changes.
exclude_also =
    ^if __name__ == "__main__":
    ^if TYPE_CHECKING:
    ^[ \t]+from \.[^\n]*(?:\n[ \t]+(?:from \.[^\n]*|\w+(?: as \w+)?,[^\n]*|\)))*(?=\nexcept ImportError)
