diff --git a/src/generic/serial_irq.c b/src/generic/serial_irq.c
index 4c05ef3ef..992996018 100644
--- a/src/generic/serial_irq.c
+++ b/src/generic/serial_irq.c
@@ -89,9 +89,12 @@ console_task(void)
 }
 DECL_TASK(console_task);
 
-// Encode and transmit a "response" message
-void
-console_sendf(const struct command_encoder *ce, va_list args)
+// Encode and queue a "response" message; 0 when it does not fit, or would
+// leave fewer than 'reserve' bytes free (ace2k's bindings hold such a frame
+// for their next tick and keep room for a command response behind it)
+uint8_t
+console_try_sendf(const struct command_encoder *ce, uint_fast8_t reserve
+                  , va_list args)
 {
     // Verify space for message
     uint_fast8_t tpos = readb(&transmit_pos), tmax = readb(&transmit_max);
@@ -101,15 +104,16 @@ console_sendf(const struct command_encoder *ce, va_list args)
         writeb(&transmit_pos, 0);
     }
     if (tmax + READP(ce->max_size) > sizeof(transmit_buf)) {
-        if (tmax - tpos + READP(ce->min_size) > sizeof(transmit_buf))
-            // Not enough space for message
-            return;
+        if (tmax - tpos + READP(ce->min_size) + reserve > sizeof(transmit_buf))
+            // Not enough space for message (and the reserve behind it)
+            return 0;
         // Disable TX irq and move buffer
         writeb(&transmit_max, 0);
         tpos = readb(&transmit_pos);
         tmax -= tpos;
         memmove(&transmit_buf[0], &transmit_buf[tpos], tmax);
         writeb(&transmit_pos, 0);
+        tpos = 0;
         writeb(&transmit_max, tmax);
         serial_enable_tx_irq();
     }
@@ -118,10 +122,18 @@ console_sendf(const struct command_encoder *ce, va_list args)
     uint8_t *buf = &transmit_buf[tmax];
     uint_fast8_t msglen = command_encode_and_frame(
         buf, sizeof(transmit_buf) - tmax, ce, args);
-    if (!msglen)
-        return;
+    if (!msglen || sizeof(transmit_buf) - (tmax - tpos) - msglen < reserve)
+        return 0;
 
     // Start message transmit
     writeb(&transmit_max, tmax + msglen);
     serial_enable_tx_irq();
+    return 1;
+}
+
+// Encode and transmit a "response" message
+void
+console_sendf(const struct command_encoder *ce, va_list args)
+{
+    console_try_sendf(ce, 0, args);
 }
diff --git a/src/i2c_software.c b/src/i2c_software.c
index ffbf754f0..c4c264b47 100644
--- a/src/i2c_software.c
+++ b/src/i2c_software.c
@@ -21,17 +21,26 @@ struct i2c_software {
     uint32_t ticks;
 };
 
+struct i2c_software *
+i2c_software_setup(uint32_t scl_pin, uint32_t sda_pin, uint32_t pulse_ticks
+                   , uint8_t addr)
+{
+    struct i2c_software *is = alloc_chunk(sizeof(*is));
+    is->ticks = pulse_ticks;
+    is->addr = (addr & 0x7f) << 1; // address format shifted
+    is->scl_out = gpio_out_setup(scl_pin, 1);
+    is->scl_in = gpio_in_setup(scl_pin, 1);
+    is->sda_out = gpio_out_setup(sda_pin, 1);
+    is->sda_in = gpio_in_setup(sda_pin, 1);
+    return is;
+}
+
 void
 command_i2c_set_sw_bus(uint32_t *args)
 {
     struct i2cdev_s *i2c = i2cdev_oid_lookup(args[0]);
-    struct i2c_software *is = alloc_chunk(sizeof(*is));
-    is->ticks = args[3];
-    is->addr = (args[4] & 0x7f) << 1; // address format shifted
-    is->scl_out = gpio_out_setup(args[1], 1);
-    is->scl_in = gpio_in_setup(args[1], 1);
-    is->sda_out = gpio_out_setup(args[2], 1);
-    is->sda_in = gpio_in_setup(args[2], 1);
+    struct i2c_software *is = i2c_software_setup(args[1], args[2], args[3]
+                                                 , args[4]);
     i2cdev_set_software_bus(i2c, is);
 }
 DECL_COMMAND(command_i2c_set_sw_bus,
