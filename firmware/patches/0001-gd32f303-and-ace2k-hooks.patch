diff --git a/src/generic/armcm_timer.c b/src/generic/armcm_timer.c
index e2d77924d..fa324d9ae 100644
--- a/src/generic/armcm_timer.c
+++ b/src/generic/armcm_timer.c
@@ -117,6 +117,16 @@ static uint32_t timer_repeat_until;
 #define TIMER_MIN_TRY_TICKS 90
 #define TIMER_DEFER_REPEAT_TICKS timer_from_us(5)
 
+// A caller that stalled the core (a flash erase or program: code runs from the
+// flash being written, so no timer can fire) declares it here before it
+// re-enables interrupts; the dispatcher then catches the overdue timers up
+// instead of treating the first as a runaway.
+void
+timer_note_stall(uint32_t grace_us)
+{
+    timer_repeat_until = timer_read_time() + timer_from_us(grace_us);
+}
+
 // Invoke timers
 static uint32_t
 timer_dispatch_many(void)
