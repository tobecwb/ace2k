# ace2k — Kconfig answers for the Klipper build.  `make build` copies this file to
# klipper/.config and runs olddefconfig; edit here, never inside klipper/.
#
# The host link: UART4 on PC10/PC11 with the RS-485 driver-enable on PA11 (our serial driver,
# src/ace2k_board/serial.c), 250000 baud.  The core clock is 120 MHz through the high-driver
# path of src/stm32/gd32f30x.c (ACE2K_CLOCK_120M); drop that line
# for the 72 MHz build.  config/ace2k-deaftest.config is an image with every
# subsystem off on the wrong UART, built only for the bench's deaf-image test.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_GD32F303=y
CONFIG_STM32_FLASH_START_8000=y
CONFIG_STM32_CLOCK_REF_24M=y
CONFIG_STM32_SERIAL_UART4_PC11_PC10_RS485=y
CONFIG_SERIAL_BAUD=250000
CONFIG_ACE2K=y
CONFIG_ACE2K_LED=y
CONFIG_ACE2K_CLOCK_120M=y
# read-only: the sensors and the environment
CONFIG_ACE2K_SENSORS=y
CONFIG_ACE2K_ENV=y
# read-only: the lanes and the mains
CONFIG_ACE2K_LANE=y
CONFIG_ACE2K_MAINS=y
# read-only: the readers and the health report
CONFIG_ACE2K_RFID=y
CONFIG_ACE2K_HEALTH=y
# the feed: the motors
CONFIG_ACE2K_MOTOR=y
# the feed: the modes
CONFIG_ACE2K_FEED=y
# the tag reads
CONFIG_ACE2K_RFID_READ=y
# the dryer: the heater, the fans and the flaps under the interlock, and the dryer
CONFIG_ACE2K_HEAT=y
CONFIG_ACE2K_DRYER=y
