# ace2k — the DEAF-IMAGE TEST build.
# Every subsystem off (the link proof and the LEDs only), and the serial console on USART3
# PD8/PD9 — pins that are not the host link — so the image boots, hears nothing, and must reset itself into the
# bootloader's recovery when the link-proof window expires.  Build it with
#   make build CONFIG=config/ace2k-deaftest.config ACE2K_VERSION=$(git describe --tags --always)-deaftest
# Never flash it for any other purpose; never release it.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_GD32F303=y
CONFIG_STM32_FLASH_START_8000=y
CONFIG_STM32_CLOCK_REF_24M=y
CONFIG_STM32_SERIAL_USART3_ALT_PD9_PD8=y
CONFIG_SERIAL_BAUD=250000
CONFIG_ACE2K=y
CONFIG_ACE2K_LED=y
CONFIG_ACE2K_CLOCK_120M=y
